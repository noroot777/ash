{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ash-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "ash",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4317
    },
    {
      "name": "ash-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PORT=4400 ASH_DB=/tmp/ash-preview.db node server/dist/index.js"],
      "port": 4400
    },
    {
      "name": "ash-web-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ASH_PROXY=http://localhost:4400 npm -w web run dev -- --port 5273"],
      "port": 5273
    },
    {
      "name": "ash-web-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "ASH_PROXY=http://localhost:4317 npm -w web run dev -- --port 5274"],
      "port": 5274
    },
    {
      "name": "ash-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "mobile", "run", "web"],
      "port": 19000
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4500"],
      "port": 4500
    }
  ]
}
