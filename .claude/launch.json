{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "navi-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "navi",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4317
    },
    {
      "name": "navi-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PORT=4400 NAVI_DB=/tmp/navi-preview.db node server/dist/index.js"],
      "port": 4400
    },
    {
      "name": "navi-web-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "NAVI_PROXY=http://localhost:4400 npm -w web run dev -- --port 5273"],
      "port": 5273
    },
    {
      "name": "navi-web-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "NAVI_PROXY=http://localhost:4317 npm -w web run dev -- --port 5274"],
      "port": 5274
    },
    {
      "name": "navi-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "mobile", "run", "web"],
      "port": 19000
    }
  ]
}
