{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "harness-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "harness",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 4317
    },
    {
      "name": "harness-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PORT=4400 HARNESS_DB=/tmp/hpreview.db node server/dist/index.js"],
      "port": 4400
    },
    {
      "name": "harness-web-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "HARNESS_PROXY=http://localhost:4400 npm -w web run dev -- --port 5273"],
      "port": 5273
    },
    {
      "name": "harness-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "mobile", "run", "web"],
      "port": 19000
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4500"],
      "port": 4500
    }
  ]
}
