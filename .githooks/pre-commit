#!/bin/sh
# 根级 agent 约定文件的体积闸。挂 pre-commit 是因为「每一次膨胀都必然经过一次 commit」——
# 这是唯一和污染动作 1:1 对应的通道；挂 build 前置只覆盖得到碰前端的那部分提交（实测 46%），
# 而历史上单笔最大的三次膨胀全部落在不碰 web 的 server 侧改动里。
#
# 判断与文案都在 scripts/root-budget.mjs，这里只负责调用（sh 里做「找出最占地方的几节」太笨）。
#
# 换机器/新克隆后需要一次性执行：git config core.hooksPath .githooks
# （config 不随 clone 传播，所以这个 hook 每次都会 echo 一行，静默失效时你能立刻发现。）

echo "[pre-commit] 根约定文件体积闸"
node scripts/root-budget.mjs || exit 1
exit 0
