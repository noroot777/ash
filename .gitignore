# 不带尾斜杠：worktree 里的 node_modules 多半是借主仓那份的**软链**，
# git 把软链当文件，`node_modules/` 这条只匹配目录、忽略不掉它。
node_modules
dist/
*.log
nohup.out

# local data: sqlite db + agent run artifacts (per DESIGN.md §11)
data/
.worktrees/

.DS_Store
*.local

# generated build cache (tsc -b rewrites this every build) + machine-local
# Claude Code permission allowlist — neither belongs in version control.
*.tsbuildinfo
.claude/settings.local.json

# 本地 worktree 目录(由 EnterWorktree 创建,不入库)
.claude/worktrees/

# playwright CLI 落在工作区的临时产物(审查用完即弃;残留会弄脏工作区挡验收合并)
.playwright-cli/
playwright-report/
test-results/

# 分发包产物(npm run package)
dist-package/
