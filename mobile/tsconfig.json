{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@ash/shared": [
        "../shared/src/index.ts"
      ],
      "@ash/shared/duet": [
        "../shared/src/duet.ts"
      ],
      "@ash/shared/page-annotation-display": [
        "../shared/src/page-annotation-display.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
