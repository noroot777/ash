{
  "name": "ash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "//devEngines": "写范围不写精确版本:两台开发机的 npm 小版本不会一直一致,钉死会让其中一台的 npm install 直接 EBADDEVENGINES 退出,连带 npm run restart 断在依赖同步那一步。这里只拦真正过旧的 npm。corepack 用的 packageManager 字段只接受精确版本,跟范围约束天然打架,故不再声明。",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.9.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "mcp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "npm -w web run dev",
    "build": "npm -w shared run build && npm -w web run build && npm -w server run build && npm -w mcp run build",
    "build:mobile": "cd mobile && npx expo export -p web",
    "restart": "node scripts/restart.mjs",
    "setup": "node scripts/setup.mjs",
    "check:workspaces": "node scripts/workspace-check.mjs",
    "package": "node scripts/package.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "start": "npm -w server run start",
    "mcp": "npm -w mcp run start",
    "db:push": "npm -w server run db:push",
    "test:diagnostics": "npm -w server run test:diagnostics"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  }
}
