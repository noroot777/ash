{
  "name": "ash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web",
    "mcp"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "npm -w web run dev",
    "build": "npm -w shared run build && npm -w web run build && npm -w server run build && npm -w mcp run build",
    "build:mobile": "cd mobile && npx expo export -p web",
    "restart": "node scripts/restart.mjs",
    "setup": "node scripts/setup.mjs",
    "check:workspaces": "node scripts/workspace-check.mjs",
    "package": "node scripts/package.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "start": "npm -w server run start",
    "mcp": "npm -w mcp run start",
    "db:push": "npm -w server run db:push",
    "test:diagnostics": "npm -w server run test:diagnostics"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  }
}
